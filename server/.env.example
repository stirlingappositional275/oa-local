# ===== Server config =====
PORT=3001
NODE_ENV=production

# ===== Tenant config =====
TENANT_ID=parent
TENANT_NAME=母公司

# ===== Microsoft Azure AD Authentication =====
MSAL_CLIENT_ID=your-client-id-here
MSAL_TENANT_ID=your-tenant-id-here
MSAL_CLIENT_SECRET=your-client-secret-here
MSAL_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ===== JWT 配置 =====
JWT_SECRET=your-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# ===== Database encryption =====
# Random key (min 32 chars) for AES-256-GCM column-level encryption
DB_ENCRYPTION_KEY=your-db-encryption-key-at-least-32-chars

# ===== Database path =====
DB_PATH=./data/oa-local.db

# ===== File storage =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== Email service (Microsoft Graph API) =====
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=oa-noreply@yourcompany.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=OA审批系统 <oa-noreply@yourcompany.com>

# ===== Federation Federation (Phase 2) =====
FEDERATION_ROLE=hub
FEDERATION_API_KEY=sk-change-me-to-random-string
# PARENT_URL=https://parent-oa.company.com
# CALLBACK_ALLOWED_TENANTS=*

# ===== Admin =====
ADMIN_EMAIL=admin@yourcompany.com

# ===== CORS CORS origins =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
